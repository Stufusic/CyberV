# CyberV Environment Configuration Template
# TUÂN THỦ ĐIỀU 9 - Rule.md: Tuyệt đối KHÔNG đưa service_role key vào client

# Supabase Public API (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only (Chỉ dùng trong Edge Functions / Server admin)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Agent Backend URL
CYBERV_API_URL=https://your-project.supabase.co/functions/v1
